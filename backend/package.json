{
    "name": "ai-interview-backend",
    "version": "1.0.0",
    "description": "Backend API for AI Interview Application",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/app.js",
        "dev": "nodemon --exec ts-node src/app.ts",
        "dev:ts": "nodemon --exec ts-node src/app.ts",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "db:migrate": "node src/database/migrate.js migrate",
        "db:status": "node src/database/migrate.js status",
        "db:rollback": "node src/database/migrate.js rollback"
    },
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "dotenv": "^16.3.1",
        "socket.io": "^4.7.4",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.11.3",
        "multer": "^1.4.5-lts.1",
        "aws-sdk": "^2.1490.0",
        "openai": "^4.20.1",
        "winston": "^3.11.0",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "cookie-parser": "^1.4.6",
        "express-session": "^1.17.3",
        "connect-redis": "^7.1.0",
        "redis": "^4.6.11"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/cors": "^2.8.17",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/pg": "^8.10.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.0",
        "@types/cookie-parser": "^1.4.6",
        "@types/express-session": "^1.17.10",
        "typescript": "^5.3.3",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.1",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.8"
    },
    "keywords": [
        "ai",
        "interview",
        "api",
        "gdpr",
        "multilingual"
    ],
    "author": "AI Interview Team",
    "license": "MIT"
}